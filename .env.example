# Dummy defaults — replace with real connection details.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Comma-separated list of dead-letter queues to poll.
DLQ_NAMES=shopee-order-batch-queue-dead-letters,tiktok-order-batch-queue-dead-letters

# How often to poll the DLQ, in milliseconds.
POLL_INTERVAL_MS=5000

# Where the SQLite archive file is written.
SQLITE_PATH=./data/dlq-messages.sqlite

# Oldest rows are dropped past this many, so the archive doesn't grow forever.
MAX_ROWS=100000
